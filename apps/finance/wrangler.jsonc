{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "tableview",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-09-03",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
