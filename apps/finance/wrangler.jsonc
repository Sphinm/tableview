		{
			"binding": "tableview_logs",
			"database_name": "tableview_logs",
			"database_id": "094641b5-1b90-4c0e-b124-666745abadfb"
		}
	],
	"vars": {
		"GOOGLE_CLIENT_ID": "31608768589-eiqse3nup8fffuhf17utrvjnt5085gg1.apps.googleusercontent.com",
		"APP_URL": "https://tableview.dev",
		"DODO_PRODUCT_DEAL_PASS": "pdt_0NoH8a1OCj6WLZs1X4QEp",
		"DODO_PRODUCT_PRO_MONTHLY": "pdt_0NoH8xSY84Q9x8j4N0b0V",
