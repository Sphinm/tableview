{
  "name": "tableview-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.0.0"
  },
  "scripts": {
    "dev:finance": "bun --filter @tableview/finance dev",
    "dev:tools": "bun --filter @tableview/tools dev",
    "dev:compressor": "bun --filter @tableview/compressor dev",
    "build:finance": "bun --filter @tableview/finance build",
    "build:tools": "bun --filter @tableview/tools build",
    "build:compressor": "bun --filter @tableview/compressor build",
    "build:all": "bun run build:finance && bun run build:tools && bun run build:compressor",
    "test": "bun test",
    "lint": "oxlint"
  },
  "devDependencies": {
    "oxlint": "^1.79.0",
    "wrangler": "^4.132.0"
  }
}
